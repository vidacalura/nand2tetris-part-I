/**
 * 4-way demultiplexor:
 * [a, b, c, d] = [in, 0, 0, 0] if sel = 00
 *                [0, in, 0, 0] if sel = 01
 *                [0, 0, in, 0] if sel = 10
 *                [0, 0, 0, in] if sel = 11
 */
CHIP DMux4Way {
    IN in, sel[2];
    OUT a, b, c, d;

    PARTS:
    // a
    Not(in=sel[0], out=notsel0);
    Not(in=sel[1], out=notsel1);
    And(a=notsel0, b=notsel1, out=a1);
    And(a=in, b=a1, out=a);
    // b
    And(a=sel[0], b=notsel1, out=b1);
    And(a=in, b=b1, out=b);
    // c
    And(a=notsel0, b=sel[1], out=c1);
    And(a=in, b=c1, out=c);
    // d
    And(a=sel[0], b=sel[1], out=d1);
    And(a=in, b=d1, out=d);
}